rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function estaAutorizado() {
      return exists(/databases/$(database)/documents/usuarios_autorizados/$(request.auth.uid));
    }
    function autorizado() {
      return request.auth != null && estaAutorizado();
    }
    function ehAdmin() {
      return get(/databases/$(database)/documents/usuarios_autorizados/$(request.auth.uid)).data.papel == "admin";
    }
    function admin() {
      return request.auth != null && ehAdmin();
    }
    function meuFuncionarioId() {
      return get(/databases/$(database)/documents/usuarios_autorizados/$(request.auth.uid)).data.get("funcionarioId", "");
    }
    function emailDoLogin() {
      return request.auth.token.email.lower();
    }
    match /usuarios_autorizados/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || ehAdmin());
      allow list: if admin();
      // Convidado cria o próprio perfil, sempre como técnico.
      allow create: if admin() || (
        request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/convites/$(emailDoLogin()))
        && request.resource.data.keys().hasOnly(["papel", "funcionarioId", "nome", "email"])
        && request.resource.data.papel == "tecnico"
        && request.resource.data.email == emailDoLogin()
        && request.resource.data.funcionarioId == get(/databases/$(database)/documents/convites/$(emailDoLogin())).data.funcionarioId
      );
      allow update, delete: if admin();
    }
    match /convites/{email} {
      allow get: if request.auth != null && (emailDoLogin() == email || ehAdmin());
      allow list, write: if admin();
    }
    match /funcionarios/{funcionarioId} {
      allow get: if autorizado() && (ehAdmin() || meuFuncionarioId() == funcionarioId);
      allow list, write: if admin();
    }
    match /servicos_equipe/{servicoId} {
      allow read: if autorizado() && (ehAdmin() || resource.data.funcionarioId == meuFuncionarioId());
      allow create, delete: if admin();
      // Técnico só muda o andamento do próprio serviço.
      allow update: if admin() || (
        autorizado()
        && resource.data.funcionarioId == meuFuncionarioId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "concluidoEm"])
        && request.resource.data.status in ["Em andamento", "Concluído"]
      );
    }
    // Leitura pública apenas de um documento pelo ID (QR Code e relatório
    // público). Listar a coleção inteira exige usuário autorizado.
    match /clientes/{clienteId} {
      allow get: if true;
      allow list: if autorizado();
      allow write: if autorizado();
    }
    match /equipamentos/{equipamentoId} {
      allow get: if true;
      allow list: if autorizado();
      allow write: if autorizado();
    }
    match /ordens_servico/{osId} {
      allow get: if true;
      allow list: if autorizado();
      allow create, update: if autorizado();
      allow delete: if request.auth != null && ehAdmin();
    }
    // Resumo mostrado na página pública do QR Code.
    match /historico_publico/{equipamentoId} {
      allow get: if true;
      allow list: if autorizado();
      allow write: if autorizado();
    }
    match /orcamentos/{orcamentoId} {
      allow read, create, update: if autorizado();
      allow delete: if request.auth != null && ehAdmin();
    }
    match /tabela_precos/{itemId} {
      allow read, write: if autorizado();
    }
    match /contadores/{contadorId} {
      allow read, write: if autorizado();
    }
    // Dados financeiros: somente administrador.
    match /lancamentos/{lancamentoId} {
      allow read, write: if request.auth != null && ehAdmin();
    }
    // Cobranças mensais dos contratos PMOC (viram lançamento ao receber).
    match /cobrancas/{cobrancaId} {
      allow read, write: if request.auth != null && ehAdmin();
    }
    match /contas_fixas/{contaId} {
      allow read, write: if request.auth != null && ehAdmin();
    }
    // Módulos: Garantias, Cadastro Preventivo e Relatórios Técnicos.
    match /garantias/{garantiaId} {
      allow read, create, update: if autorizado();
      allow delete: if request.auth != null && ehAdmin();
    }
    match /preventivos/{preventivoId} {
      allow read, create, update: if autorizado();
      allow delete: if request.auth != null && ehAdmin();
    }
    match /laudos/{laudoId} {
      allow read, create, update: if autorizado();
      allow delete: if request.auth != null && ehAdmin();
    }
    // Anotações são pessoais: cada usuário só vê e altera as próprias.
    match /anotacoes/{anotacaoId} {
      allow read, update, delete: if autorizado() && resource.data.criadoPor == request.auth.uid;
      allow create: if autorizado() && request.resource.data.criadoPor == request.auth.uid;
    }
    match /plano_atividades/{planoId} {
      allow read, write: if request.auth != null && estaAutorizado();
    }
  }
}
