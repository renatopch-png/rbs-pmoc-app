rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function estaAutorizado() {
      return exists(/databases/$(database)/documents/usuarios_autorizados/$(request.auth.uid));
    }
    function ehAdmin() {
      return get(/databases/$(database)/documents/usuarios_autorizados/$(request.auth.uid)).data.papel == "admin";
    }
    match /usuarios_autorizados/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if ehAdmin();
    }
    match /clientes/{clienteId} {
      // Leitura pública: a página do QR Code do equipamento (/eq/:id) e o
      // relatório de manutenção público (/relatorio/:osId) mostram o nome
      // do cliente e o telefone (para o botão do WhatsApp) sem exigir
      // login — quem acessa não é obrigatoriamente um usuário do sistema.
      allow read: if true;
      allow write: if request.auth != null && estaAutorizado();
    }
    match /equipamentos/{equipamentoId} {
      allow read: if true;
      allow write: if request.auth != null && estaAutorizado();
    }
    match /ordens_servico/{osId} {
      allow read: if true;
      allow write: if request.auth != null && estaAutorizado();
    }
    match /plano_atividades/{planoId} {
      allow read, write: if request.auth != null && estaAutorizado();
    }
  }
}
